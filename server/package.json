{
  "name": "focusflow-server",
  "version": "1.0.0",
  "private": true,
  "description": "FocusFlow Backend API Server with Google OAuth, Sessions, and Prisma ORM",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "tsx --test src/tests/*.test.ts",
    "test:watch": "tsx --test --watch src/tests/*.test.ts",
    "prisma:generate": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma generate",
    "prisma:migrate": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma migrate dev",
    "prisma:push": "PRISMA_CLIENT_ENGINE_TYPE=binary prisma db push",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.64.8",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.12",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^1.6.0"
  }
}
