generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "darwin", "darwin-arm64"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String          @id @default(uuid())
  googleId  String          @unique
  email     String          @unique
  name      String
  avatarUrl String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  preference UserPreference?
  subjects   Subject[]
  tasks      StudyTask[]
  sessions   FocusSession[]

  @@map("users")
}

model UserPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  focusDuration          Int      @default(25) // in minutes
  shortBreakDuration     Int      @default(5)  // in minutes
  longBreakDuration      Int      @default(15) // in minutes
  longBreakInterval      Int      @default(4)  // sessions before long break
  dailyGoalMinutes       Int      @default(120) // target minutes per day
  soundEnabled           Boolean  @default(true)
  notificationsEnabled   Boolean  @default(false)
  theme                  String   @default("dark")
  timezone               String   @default("UTC")
  hasCompletedOnboarding Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Subject {
  id                String         @id @default(uuid())
  userId            String
  name              String
  description       String?
  color             String         @default("#f97316") // Hex color
  weeklyGoalMinutes Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks    StudyTask[]
  sessions FocusSession[]

  @@index([userId])
  @@index([userId, name])
  @@map("subjects")
}

model StudyTask {
  id                String         @id @default(uuid())
  userId            String
  subjectId         String?
  title             String
  description       String?
  dueDate           DateTime?
  priority          String         @default("MEDIUM") // LOW, MEDIUM, HIGH
  estimatedSessions Int            @default(1)
  completedSessions Int            @default(0)
  isCompleted       Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sessions FocusSession[]

  @@index([userId])
  @@index([userId, isCompleted])
  @@index([userId, dueDate])
  @@map("study_tasks")
}

model FocusSession {
  id              String    @id @default(uuid())
  userId          String
  subjectId       String?
  taskId          String?
  sessionType     String    @default("FOCUS") // FOCUS, SHORT_BREAK, LONG_BREAK
  status          String    @default("RUNNING") // RUNNING, PAUSED, COMPLETED, ABANDONED, SKIPPED
  plannedDuration Int       // in seconds
  actualDuration  Int       @default(0) // in seconds
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  targetEndAt     DateTime?
  pauseIntervals  String?   // JSON representation of pauses for exact calculation
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  task    StudyTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
  @@index([userId, startedAt])
  @@map("focus_sessions")
}

model Session {
  sid    String   @id @map("sid")
  sess   Json     @map("sess")
  expire DateTime @map("expire")

  @@index([expire])
  @@map("sessions")
}
